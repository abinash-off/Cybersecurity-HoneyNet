# =============================================================================
# HoneyNet Live — environment template
# Copy to .env and change every secret before starting services.
# NEVER commit .env
# =============================================================================

# demo | live | both
DATA_MODE=demo

HONEYPOT_NAME=HoneyNet-Live-Lab
HONEYPOT_LAT=12.9716
HONEYPOT_LON=77.5946
HONEYPOT_CITY=Bengaluru
HONEYPOT_COUNTRY=India

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRE_MINUTES=480

APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:8080
MASK_SENSITIVE=true
MASK_IPS=false
API_RATE_LIMIT=120/minute

DATABASE_URL=sqlite:////data/honeynet.db
REDIS_URL=redis://redis:6379/0
RETENTION_RAW_DAYS=14
RETENTION_STATS_DAYS=90
RETENTION_MALWARE_DAYS=90
CLEANUP_INTERVAL_SECONDS=3600

COWRIE_JSON_LOG=/cowrie-var/log/cowrie/cowrie.json
COWRIE_DOWNLOADS_DIR=/cowrie-var/lib/cowrie/downloads

AUTO_BLOCK_MODE=disabled
BLOCK_FAILED_LOGINS=25
BLOCK_WINDOW_MINUTES=15
BLOCK_DURATION_MINUTES=60
BLOCK_HIGH_VOLUME=120

GEO_PROVIDER=ip-api
GEO_CACHE_TTL_SECONDS=86400
ABUSEIPDB_API_KEY=
ABUSEIPDB_ENABLED=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

DEMO_EVENTS_PER_MINUTE=18
ML_RETRAIN_SECONDS=300
ML_MIN_ATTACKERS=8
